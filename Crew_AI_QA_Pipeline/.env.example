# Jira QA Crew - example environment.
# Copy to .env and fill in. Never commit the real .env.

# ---------------------------------------------------------------- application
APP_NAME=Jira QA Crew
APP_ENV=development
OUTPUT_DIR=outputs
LOG_LEVEL=INFO

# Demo mode reads tickets from fixtures/jira/*.json instead of Jira.
# It is opt-in only and is never used as a fallback for a failed live call.
DEMO_MODE=false

# ------------------------------------------------------------------------ LLM
# Any LiteLLM/CrewAI model id. Do not hard-code this in application code.
#   OpenAI  : openai/gpt-4.1-mini
#   Groq    : openai/gpt-oss-120b   with LLM_BASE_URL=https://api.groq.com/openai/v1
#   Anthropic: anthropic/claude-sonnet-4-5
LLM_MODEL=openai/gpt-4.1-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.1
# 0 leaves the provider default in place.
LLM_MAX_TOKENS=0

# ----------------------------------------------------------------- Jira core
# auto = try MCP then REST. mcp = MCP only. rest = REST only.
JIRA_INTEGRATION_MODE=auto
JIRA_URL=https://your-domain.atlassian.net
# basic = email + API token (Jira Cloud). bearer = OAuth / PAT.
JIRA_AUTH_MODE=basic
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_BEARER_TOKEN=
JIRA_API_VERSION=3
# Custom field id holding acceptance criteria, e.g. customfield_10011.
# Leave empty to auto-detect from the field names Jira returns.
JIRA_ACCEPTANCE_CRITERIA_FIELD=
JIRA_INCLUDE_COMMENTS=false
JIRA_MAX_COMMENTS=20
JIRA_TIMEOUT_SECONDS=20
JIRA_MAX_ATTEMPTS=3
JIRA_KEY_PATTERN=^[A-Z][A-Z0-9]{1,19}-\d{1,9}$

# ------------------------------------------------------------------ Jira MCP
# streamable_http | sse | stdio
JIRA_MCP_TRANSPORT=streamable_http
JIRA_MCP_URL=
# stdio transport only:
JIRA_MCP_COMMAND=
JIRA_MCP_ARGS_JSON=[]
JIRA_MCP_ENV_JSON={}
# Headers for http/sse transports, e.g. {"Authorization":"Bearer ..."}
JIRA_MCP_HEADERS_JSON={}
# Leave empty to auto-discover a read-only "get issue" tool.
JIRA_MCP_GET_ISSUE_TOOL=
JIRA_MCP_ISSUE_KEY_ARG=issueIdOrKey
# Extra static arguments merged into every issue fetch call.
JIRA_MCP_EXTRA_ARGS_JSON={}
JIRA_MCP_TIMEOUT_SECONDS=20

# ------------------------------------------------------------------- pipeline
PIPELINE_MAX_TICKETS=20
PIPELINE_MAX_RETRIES=2
PIPELINE_TICKET_TIMEOUT_SECONDS=600
PIPELINE_MAX_INPUT_CHARS=4000
PIPELINE_MAX_FIELD_CHARS=20000
