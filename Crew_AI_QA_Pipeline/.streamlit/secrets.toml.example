# Streamlit secrets for Jira QA Crew.
# Copy to .streamlit/secrets.toml locally, or paste into the
# "Secrets" box of a Streamlit Community Cloud app. Never commit the real file.
#
# Keys are copied into the process environment at startup, so they use the same
# names as .env. Real environment variables always take precedence.

LLM_MODEL = "openai/gpt-4.1-mini"
LLM_API_KEY = "sk-..."
LLM_BASE_URL = ""
LLM_TEMPERATURE = "0.1"

JIRA_INTEGRATION_MODE = "auto"
JIRA_URL = "https://your-domain.atlassian.net"
JIRA_AUTH_MODE = "basic"
JIRA_EMAIL = "you@example.com"
JIRA_API_TOKEN = "ATATT..."
JIRA_API_VERSION = "3"
JIRA_ACCEPTANCE_CRITERIA_FIELD = ""

JIRA_MCP_TRANSPORT = "streamable_http"
JIRA_MCP_URL = ""
JIRA_MCP_HEADERS_JSON = "{}"
JIRA_MCP_GET_ISSUE_TOOL = ""
JIRA_MCP_TIMEOUT_SECONDS = "20"

PIPELINE_MAX_TICKETS = "20"
PIPELINE_TICKET_TIMEOUT_SECONDS = "600"
DEMO_MODE = "false"
